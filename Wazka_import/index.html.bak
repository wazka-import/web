<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wazka Import | Perfumería Urbana</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f5f5;
      color: #111111;
      overflow-x: hidden;
    }

    button,
    input {
      font-family: inherit;
    }

    .countdown-bar {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 60;
      width: 100%;
      min-height: 38px;
      background: #111111;
      color: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 8px 18px;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      text-align: center;
    }

    .countdown-time {
      color: #f5f5f5;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid rgba(245,245,245,0.28);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .navbar {
      position: fixed;
      top: 38px;
      left: 0;
      z-index: 50;
      width: 100%;
      height: 72px;
      background: rgba(245, 245, 245, 0.92);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(17, 17, 17, 0.08);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 38px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 28px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .nav-link {
      color: #111111;
      text-decoration: none;
      transition: opacity 0.25s ease;
    }

    .nav-link:hover {
      opacity: 0.55;
    }

    .brand-logo {
      font-weight: 900;
      font-size: 24px;
      letter-spacing: -0.08em;
      text-transform: uppercase;
      line-height: 1;
    }

    .brand-logo span {
      display: block;
      font-size: 9px;
      letter-spacing: 0.28em;
      text-align: center;
      margin-top: 3px;
      font-weight: 700;
    }

    .mobile-menu {
      display: none;
    }

    .hero {
      margin-top: 110px;
      position: relative;
      min-height: calc(100vh - 110px);
      background: #111111;
      color: #f5f5f5;
      overflow: hidden;
    }

    .hero-slider {
      position: absolute;
      inset: 0;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: scale(1.04);
      transition: opacity 900ms ease, transform 1400ms ease;
    }

    .hero-slide.active {
      opacity: 1;
      transform: scale(1);
    }

    .hero-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(20%) contrast(1.08) brightness(0.72);
    }

    .hero-slide::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 35%, rgba(255,255,255,0.05), transparent 26%),
        linear-gradient(180deg, rgba(17,17,17,0.16), rgba(17,17,17,0.88));
    }

    .hero-content {
      position: relative;
      z-index: 2;
      min-height: calc(100vh - 110px);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      text-align: center;
      padding: 48px 24px 56px;
    }

    .hero-kicker {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .hero-title {
      font-size: clamp(54px, 10vw, 138px);
      line-height: 0.82;
      letter-spacing: -0.09em;
      text-transform: uppercase;
      font-weight: 950;
      max-width: 1000px;
    }

    .hero-title em {
      font-style: normal;
      display: inline-block;
      transform: skew(-9deg);
    }

    .hero-copy {
      margin-top: 18px;
      font-size: clamp(16px, 2vw, 22px);
      max-width: 560px;
      line-height: 1.25;
      color: rgba(245,245,245,0.86);
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 26px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border: 0;
      border-radius: 999px;
      padding: 13px 25px;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.24s ease, opacity 0.24s ease, background 0.24s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: #f5f5f5;
      color: #111111;
    }

    .btn-secondary {
      background: rgba(245,245,245,0.12);
      color: #f5f5f5;
      border: 1px solid rgba(245,245,245,0.38);
    }

    .hero-controls {
      position: absolute;
      z-index: 3;
      right: 34px;
      bottom: 34px;
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .control-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 0;
      background: rgba(245,245,245,0.9);
      color: #111111;
      display: grid;
      place-items: center;
      font-size: 22px;
      font-weight: 900;
      cursor: pointer;
    }

    .dots {
      position: absolute;
      z-index: 3;
      bottom: 25px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(245,245,245,0.45);
      border: 0;
    }

    .dot.active {
      background: #f5f5f5;
    }

    .section {
      padding: 58px 38px;
    }

    .shop-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 36px;
    }

    .filters {
      display: flex;
      gap: 22px;
      flex-wrap: wrap;
    }

    .filter-btn {
      border: 0;
      background: transparent;
      color: #111111;
      font-size: clamp(18px, 2.1vw, 34px);
      font-weight: 900;
      letter-spacing: -0.06em;
      text-transform: uppercase;
      cursor: pointer;
      opacity: 0.32;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .filter-btn:hover,
    .filter-btn.active {
      opacity: 1;
      transform: translateY(-1px);
    }

    .search-box {
      width: min(360px, 100%);
      height: 52px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid rgba(17,17,17,0.08);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 18px;
      box-shadow: 0 10px 28px rgba(17,17,17,0.05);
    }

    .search-box span {
      font-size: 20px;
    }

    .search-box input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 16px;
      color: #111111;
      font-weight: 600;
    }

    .products-wrap {
      padding-bottom: 24px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 34px 22px;
    }

    .load-more-wrap {
      display: flex;
      justify-content: center;
      margin-top: 34px;
    }

    .load-more-btn {
      background: #111111;
      color: #f5f5f5;
      border: 0;
      border-radius: 999px;
      padding: 15px 34px;
      font-size: 16px;
      font-weight: 900;
      cursor: pointer;
      transition: transform 0.24s ease, opacity 0.24s ease;
    }

    .load-more-btn:hover {
      transform: translateY(-2px);
    }

    .load-more-btn.hidden {
      display: none;
    }

    .product-card {
      scroll-snap-align: start;
      cursor: pointer;
    }

    .product-image {
      position: relative;
      aspect-ratio: 1 / 1;
      background: #e9e9e9;
      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .product-card:hover img {
      transform: scale(1.05);
    }

    .badge {
      position: absolute;
      top: 16px;
      left: 16px;
      background: #f5f5f5;
      color: #111111;
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .product-info {
      padding-top: 18px;
    }

    .product-category {
      color: #ff4b00;
      font-size: 15px;
      font-weight: 900;
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .product-title {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: -0.045em;
      line-height: 1.05;
      margin-bottom: 8px;
    }

    .product-desc {
      display: none;
    }

    .product-buy-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 10px;
    }

    .product-price {
      font-size: 18px;
      font-weight: 900;
    }

    .order-btn {
      border: 0;
      border-radius: 999px;
      background: #111111;
      color: #f5f5f5;
      padding: 9px 16px;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
      transition: transform 0.22s ease, opacity 0.22s ease;
      white-space: nowrap;
    }

    .order-btn:hover {
      transform: translateY(-2px);
    }

    .floating-cart {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 80;
      width: 62px;
      height: 62px;
      border-radius: 50%;
      border: 0;
      background: #111111;
      color: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
      cursor: pointer;
      box-shadow: 0 16px 38px rgba(17,17,17,0.22);
      transition: transform 0.24s ease;
    }

    .floating-cart:hover {
      transform: translateY(-3px) scale(1.02);
    }

    .cart-count {
      position: absolute;
      top: -4px;
      right: -4px;
      min-width: 23px;
      height: 23px;
      border-radius: 999px;
      background: #f5f5f5;
      color: #111111;
      border: 2px solid #111111;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 950;
      padding: 0 6px;
    }

    .cart-overlay {
      position: fixed;
      inset: 0;
      z-index: 90;
      background: rgba(17,17,17,0.42);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s ease;
    }

    .cart-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .cart-drawer {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 100;
      width: min(420px, 100%);
      height: 100vh;
      background: #f5f5f5;
      color: #111111;
      transform: translateX(100%);
      transition: transform 0.32s ease;
      display: flex;
      flex-direction: column;
      box-shadow: -20px 0 50px rgba(17,17,17,0.16);
    }

    .cart-drawer.open {
      transform: translateX(0);
    }

    .cart-header {
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 22px;
      background: #111111;
      color: #f5f5f5;
    }

    .cart-title {
      font-size: 22px;
      font-weight: 950;
      letter-spacing: -0.05em;
    }

    .cart-close {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid rgba(245,245,245,0.28);
      background: transparent;
      color: #f5f5f5;
      font-size: 24px;
      cursor: pointer;
    }

    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(17,17,17,0.1);
    }

    .cart-item img {
      width: 72px;
      height: 72px;
      object-fit: cover;
      background: #e9e9e9;
    }

    .cart-item-name {
      font-size: 16px;
      font-weight: 950;
      letter-spacing: -0.035em;
      margin-bottom: 5px;
    }

    .cart-item-price {
      font-size: 14px;
      font-weight: 800;
      color: rgba(17,17,17,0.65);
      margin-bottom: 10px;
    }

    .quantity-control {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(17,17,17,0.14);
      border-radius: 999px;
      overflow: hidden;
    }

    .quantity-control button {
      width: 30px;
      height: 30px;
      border: 0;
      background: #111111;
      color: #f5f5f5;
      font-weight: 900;
      cursor: pointer;
    }

    .quantity-control span {
      min-width: 34px;
      text-align: center;
      font-size: 13px;
      font-weight: 900;
    }

    .cart-item-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 10px;
    }

    .remove-btn {
      border: 0;
      background: transparent;
      color: rgba(17,17,17,0.38);
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
      text-underline-offset: 2px;
      transition: color 0.2s ease;
    }

    .remove-btn:hover {
      color: #ff4b00;
    }

    .cart-empty {
      padding: 48px 0;
      text-align: center;
      font-weight: 900;
      color: rgba(17,17,17,0.5);
    }

    .cart-footer {
      padding: 18px 20px 22px;
      border-top: 1px solid rgba(17,17,17,0.1);
      background: #f5f5f5;
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 18px;
      font-weight: 950;
      margin-bottom: 10px;
    }

    .cart-separation {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 15px;
      font-weight: 900;
      color: rgba(17,17,17,0.68);
      margin-bottom: 16px;
    }

    .checkout-btn {
      width: 100%;
      border: 0;
      border-radius: 999px;
      background: #111111;
      color: #f5f5f5;
      padding: 15px 22px;
      font-size: 16px;
      font-weight: 950;
      cursor: pointer;
    }

    .checkout-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .split-feature {
      background: #111111;
      color: #f5f5f5;
      min-height: 420px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: clamp(56px, 8vw, 100px) 38px;
    }

    .split-feature::before {
      content: "WAZKA IMPORT · WAZKA IMPORT · WAZKA IMPORT · WAZKA IMPORT";
      position: absolute;
      top: 18px;
      left: -20px;
      white-space: nowrap;
      font-size: clamp(38px, 8vw, 110px);
      line-height: 1;
      font-weight: 950;
      letter-spacing: -0.09em;
      color: rgba(245,245,245,0.06);
      text-transform: uppercase;
    }

    .split-feature::after {
      content: "NO HUELAS COMO LOS DEMÁS";
      position: absolute;
      bottom: -8px;
      right: -18px;
      white-space: nowrap;
      font-size: clamp(42px, 9vw, 130px);
      line-height: 1;
      font-weight: 950;
      letter-spacing: -0.1em;
      color: rgba(245,245,245,0.08);
      text-transform: uppercase;
    }

    .feature-image {
      display: none;
    }

    .feature-content {
      position: relative;
      z-index: 2;
      width: min(980px, 100%);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .feature-tag {
      font-size: 14px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: rgba(245,245,245,0.62);
      margin-bottom: 22px;
    }

    .feature-title {
      font-size: clamp(44px, 7vw, 112px);
      line-height: 0.86;
      letter-spacing: -0.09em;
      font-weight: 950;
      text-transform: uppercase;
      margin-bottom: 26px;
    }

    .feature-copy {
      font-size: clamp(17px, 1.6vw, 22px);
      line-height: 1.3;
      color: rgba(245,245,245,0.76);
      max-width: 500px;
      margin-bottom: 28px;
    }

    .how-it-works {
      background: #0d0d0d;
      color: #f5f5f5;
      padding: 72px 38px 56px;
      position: relative;
      overflow: hidden;
    }

    .how-it-works::before {
      content: "WAZKA · IMPORT · CONSOLIDADOS · PERFUMES";
      position: absolute;
      top: 18px;
      left: -18px;
      font-size: clamp(42px, 8vw, 118px);
      line-height: 1;
      font-weight: 950;
      letter-spacing: -0.09em;
      color: rgba(245,245,245,0.045);
      white-space: nowrap;
      text-transform: uppercase;
      pointer-events: none;
    }

    .how-header {
      position: relative;
      z-index: 2;
      text-align: center;
      margin-bottom: 42px;
    }

    .how-title {
      font-size: clamp(38px, 6vw, 72px);
      line-height: 0.92;
      letter-spacing: -0.08em;
      font-weight: 950;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .how-subtitle {
      font-size: 18px;
      color: rgba(245,245,245,0.68);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .how-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .how-card {
      position: relative;
      min-height: 260px;
      border-radius: 18px;
      padding: 22px;
      background: linear-gradient(180deg, rgba(245,245,245,0.055), rgba(245,245,245,0.018));
      border: 1px solid rgba(245,245,245,0.18);
      overflow: hidden;
    }

    .how-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(245,245,245,0.085), transparent 42%);
      pointer-events: none;
    }

    .how-top {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 26px;
    }

    .how-number {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid currentColor;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 950;
      flex-shrink: 0;
    }

    .how-line {
      height: 1px;
      width: 100%;
      background: rgba(245,245,245,0.2);
    }

    .how-card-title {
      position: relative;
      z-index: 2;
      font-size: clamp(26px, 3vw, 38px);
      line-height: 0.96;
      letter-spacing: -0.06em;
      font-weight: 950;
      margin-bottom: 14px;
    }

    .how-card-copy {
      position: relative;
      z-index: 2;
      font-size: 17px;
      line-height: 1.34;
      color: rgba(245,245,245,0.74);
      max-width: 340px;
    }

    .how-accent-1,
    .how-accent-2,
    .how-accent-3 {
      color: #f5f5f5;
      border-color: rgba(245,245,245,0.22);
    }

    .how-card:hover {
      border-color: rgba(245,245,245,0.48);
      background: linear-gradient(180deg, rgba(245,245,245,0.09), rgba(245,245,245,0.025));
    }

    .how-accent-1 .how-card-copy,
    .how-accent-2 .how-card-copy,
    .how-accent-3 .how-card-copy {
      color: rgba(245,245,245,0.74);
    }

    .how-terms {
      position: relative;
      z-index: 2;
      margin-top: 24px;
      text-align: center;
      font-size: 13px;
      color: rgba(245,245,245,0.52);
      line-height: 1.4;
    }

    .how-terms a {
      color: rgba(245,245,245,0.84);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .footer {
      padding: 38px;
      background: #f5f5f5;
      color: #111111;
      display: flex;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      border-top: 1px solid rgba(17,17,17,0.08);
      font-weight: 800;
    }

    .empty-state {
      display: none;
      padding: 60px 0;
      font-size: 28px;
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 1.2;
    }

    .empty-state a {
      color: #ff4b00;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }

    @media (max-width: 920px) {
      .navbar {
        padding: 0 18px;
        grid-template-columns: 1fr auto 1fr;
      }

      .countdown-bar {
        font-size: 12px;
      }

      .nav-right {
        gap: 16px;
        font-size: 14px;
      }

      .shop-head {
        align-items: flex-start;
        flex-direction: column;
      }

      .split-feature {
        padding-inline: 18px;
      }

      .how-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .hero-content {
        align-items: flex-start;
        text-align: left;
        padding-inline: 18px;
      }

      .hero-actions {
        justify-content: flex-start;
      }

      .hero-controls {
        display: none;
      }

      .dots {
        left: 18px;
        transform: none;
      }

      .section {
        padding: 42px 18px;
      }

      .products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px 14px;
      }

      .product-title {
        font-size: 16px;
      }

      .product-category {
        font-size: 12px;
        margin-bottom: 8px;
      }

      .product-price {
        font-size: 15px;
      }

      .product-buy-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }

      .order-btn {
        width: 100%;
        padding: 9px 10px;
        font-size: 12px;
      }

      .floating-cart {
        right: 16px;
        bottom: 16px;
        width: 56px;
        height: 56px;
        font-size: 22px;
      }

      .badge {
        top: 10px;
        left: 10px;
        font-size: 10px;
        padding: 6px 9px;
      }

      .filter-btn {
        font-size: 24px;
      }

      .how-it-works {
        padding: 52px 18px 42px;
      }

      .how-header {
        text-align: left;
        margin-bottom: 28px;
      }

      .how-card {
        min-height: auto;
        padding: 18px;
      }

      .how-card-copy {
        font-size: 15px;
      }

      .footer {
        padding: 28px 18px;
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <div class="countdown-bar">
    <span>Fin del consolidado</span>
    <span class="countdown-time" id="countdownTimer">Cargando...</span>
  </div>

  <header class="navbar">
    <div></div>

    <a class="brand-logo nav-link" href="#inicio" aria-label="Wazka Import">
      WAZKA
      <span>IMPORT</span>
    </a>

    <nav class="nav-right" aria-label="Navegación principal">
      <a class="nav-link" href="#catalogo">Catálogo</a>
      <a class="nav-link" href="https://wa.link/kchumv" target="_blank">Contacto</a>
    </nav>
  </header>

  <main id="inicio">
    <section class="hero" aria-label="Portada principal">
      <div class="hero-slider">
        <div class="hero-slide active">
          <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=2200&q=85" alt="Perfume urbano premium sobre fondo oscuro" />
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1619994403073-2cec844b8e63?auto=format&fit=crop&w=2200&q=85" alt="Fragancias de diseñador" />
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1615634260167-c8cdede054de?auto=format&fit=crop&w=2200&q=85" alt="Perfume elegante en luz dramática" />
        </div>
      </div>

      <div class="hero-content">
        <p class="hero-kicker" id="heroKicker">Wazka Import</p>
        <h1 class="hero-title" id="heroTitle">Fragancias <em>que entran fuerte</em></h1>
        <p class="hero-copy" id="heroCopy">Árabes, diseñador, nichos y packs seleccionados para oler distinto todos los días.</p>
        <div class="hero-actions" id="heroActions">
          <button class="btn btn-primary" onclick="window.open('https://wa.link/kchumv','_blank')">Pedir ahora</button>
          <a class="btn btn-secondary" href="#catalogo">Ver productos</a>
        </div>
      </div>

      <div class="dots" aria-hidden="true">
        <button class="dot active"></button>
        <button class="dot"></button>
        <button class="dot"></button>
      </div>

      <div class="hero-controls">
        <button class="control-btn" onclick="changeSlide(-1)" aria-label="Imagen anterior">‹</button>
        <button class="control-btn" onclick="changeSlide(1)" aria-label="Siguiente imagen">›</button>
      </div>
    </section>

    <section class="section" id="catalogo">
      <div class="shop-head">
        <div class="filters" aria-label="Filtros de productos">
          <button class="filter-btn active" data-filter="TODOS" onclick="filterProducts('TODOS')">Todos</button>
          <button class="filter-btn" data-filter="ARABE" onclick="filterProducts('ARABE')">Árabe</button>
          <button class="filter-btn" data-filter="DISENADOR" onclick="filterProducts('DISENADOR')">Diseñador</button>
          <button class="filter-btn" data-filter="NICHOS" onclick="filterProducts('NICHOS')">Nichos</button>
          <button class="filter-btn" data-filter="PACKS" onclick="filterProducts('PACKS')">Packs</button>
        </div>

        <label class="search-box" for="searchInput">
          <span>⌕</span>
          <input id="searchInput" type="search" placeholder="Buscar perfume" oninput="renderProducts()" />
        </label>
      </div>

      <div class="products-wrap">
        <div class="products" id="productsGrid"></div>
      </div>
      <div class="load-more-wrap">
        <button class="load-more-btn" id="loadMoreBtn" onclick="loadMoreProducts()">Ver más</button>
      </div>
      <div class="empty-state" id="emptyState"></div>
    </section>

    <section class="split-feature" id="nichos">
      <div class="feature-content">
        <p class="feature-tag">Drop destacado</p>
        <h2 class="feature-title">No huelas igual que todos</h2>
        <p class="feature-copy">Únete a la comunidad del tío Wazka para ayudarte a elegir la mejor fragancia para ti.</p>
        <button class="btn btn-primary" onclick="window.open('https://chat.whatsapp.com/Ltha5XJ9iYC5gocCdlWqLy?mode=gi_t','_blank')">Unirme a la comunidad</button>
      </div>
    </section>

    <section class="how-it-works" id="como-funciona">
      <div class="how-header">
        <h2 class="how-title">¿Cómo funciona?</h2>
        <p class="how-subtitle">3 pasos</p>
      </div>

      <div class="how-grid">
        <article class="how-card how-accent-1">
          <div class="how-top">
            <div class="how-number">1</div>
            <div class="how-line"></div>
          </div>
          <h3 class="how-card-title">Contáctanos</h3>
          <p class="how-card-copy">Contáctanos para separar los perfumes. La separación se realiza con el 30%.</p>
        </article>

        <article class="how-card how-accent-2">
          <div class="how-top">
            <div class="how-number">2</div>
            <div class="how-line"></div>
          </div>
          <h3 class="how-card-title">Espera tu pedido</h3>
          <p class="how-card-copy">Una vez hecha la compra, el perfume llega dentro de 10 a 12 días.</p>
        </article>

        <article class="how-card how-accent-3">
          <div class="how-top">
            <div class="how-number">3</div>
            <div class="how-line"></div>
          </div>
          <h3 class="how-card-title">Entrega y cancelación</h3>
          <p class="how-card-copy">Cuando el pedido llega a Perú, se coordina la entrega y la cancelación final.</p>
        </article>
      </div>

      <p class="how-terms">Para mayor información contáctanos <a href="https://wa.link/kchumv">aquí</a>.</p>
    </section>
  </main>

  <footer class="footer" id="contacto">
    <div>WAZKA IMPORT © 2026</div>
    <div>Consolidados · Lima, Perú</div>
    <div>
      <a href="https://www.instagram.com/wazka.import/" target="_blank" class="nav-link">Instagram</a>
      ·
      <a href="https://www.tiktok.com/@wazka.import" target="_blank" class="nav-link">Tik Tok</a>
    </div>
  </footer>

  <button class="floating-cart" onclick="toggleCart(true)" aria-label="Abrir carrito">
    🛒
    <span class="cart-count" id="cartCount">0</span>
  </button>

  <div class="cart-overlay" id="cartOverlay" onclick="toggleCart(false)"></div>

  <aside class="cart-drawer" id="cartDrawer" aria-label="Carrito de pedidos">
    <div class="cart-header">
      <h2 class="cart-title">Carrito</h2>
      <button class="cart-close" onclick="toggleCart(false)" aria-label="Cerrar carrito">×</button>
    </div>

    <div class="cart-items" id="cartItems"></div>

    <div class="cart-footer">
      <div class="cart-total">
        <span>Total</span>
        <span id="cartTotal">S/ 0.00</span>
      </div>
      <div class="cart-separation">
        <span>Monto para separar</span>
        <span id="cartSeparation">S/ 0.00</span>
      </div>
      <button class="checkout-btn" id="checkoutBtn" onclick="checkoutOrder()" disabled>Realizar pedido</button>
    </div>
  </aside>

  <script>
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.dot');
    const heroKicker = document.getElementById('heroKicker');
    const heroTitle = document.getElementById('heroTitle');
    const heroCopy = document.getElementById('heroCopy');
    let currentSlide = 0;
    let activeFilter = 'TODOS';
    let cart = [];

    const heroMessages = [
      {
        kicker: 'Wazka Import',
        title: 'Fragancias <em>que entran fuerte</em>',
        copy: 'Árabes, diseñador, nichos y packs seleccionados para oler distinto todos los días.',
        buttons: [
          { text: 'Pedir ahora', style: 'btn-primary', action: "window.open('https://wa.link/kchumv','_blank')" },
          { text: 'Ver productos', style: 'btn-secondary', action: "document.querySelector('#catalogo').scrollIntoView({ behavior: 'smooth' })" }
        ]
      },
      {
        kicker: 'Compra inteligente',
        title: 'Separa tus productos <em>con 30%</em>',
        copy: 'Cancela el resto cuando tus productos lleguen a Perú. Fácil, claro y sin complicarte.',
        buttons: [
          { text: 'Pedir ahora', style: 'btn-primary', action: "window.open('https://wa.link/kchumv','_blank')" }
        ]
      },
      {
        kicker: 'Comunidad Wazka',
        title: 'Únete a Wazka Import <em>en WhatsApp</em>',
        copy: 'Recibe drops, preventas, ofertas y novedades antes que todos.',
        buttons: [
          { text: 'Unirme ahora', style: 'btn-primary', action: "window.open('https://chat.whatsapp.com/Ltha5XJ9iYC5gocCdlWqLy?mode=gi_t','_blank')" }
        ]
      }
    ];
    let visibleProducts = 6;

    const products = [
      {
        name: 'Khamrah Qahwa',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 116.18',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/khamrah-qahwa-8596025_7809b3e7-3f10-451f-9f4e-3ab8c1297099.webp?v=1759183114&width=1024'
      },
      {
        name: 'Khamrah Dukhan',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 119.73',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/khamrah-dukhan-lattafa-perfumes-for-men-7442173.jpg?v=1759183660&width=1206'
      },
      {
        name: 'Sublime',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 107.12',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/badee-al-oud-sublime-3246757.webp?v=1759183097&width=1206'
      },
      {
        name: 'Honor & Glory',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 103.75',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/badee-al-oud-honor-amp-glory-1764474.webp?v=1759183098&width=246'
      },
      {
        name: 'Amethyst',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 100.16',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/badee-al-oud-amethyst-8962563.webp?v=1759183097&width=713'
      },
      {
        name: 'Ouf for glory',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 100.02',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/badee-al-oud-oud-for-glory-6816954.webp?v=1759183096&width=823'
      },
      {
        name: 'Noble Blush',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 107.12',
        image: 'https://wholesale.cristfragances.com/cdn/shop/files/lattafabadeealoudnobleblush_2000x_c53cb9fe-b3a7-4e57-8cb0-f36d0b738816.webp?v=1778765425&width=1346'
      },
      {
        name: 'Asad',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 103.57',
        image: 'https://cristfragances.com/cdn/shop/files/asad-34oz-2585401.jpg?v=1757294342&width=1620'
      },
      {
        name: 'Asad Bourbon',
        category: 'ARABE',
        tag: '',
        desc: '',
        price: 'S/ 107.12',
        image: 'https://cristfragances.com/cdn/shop/files/asad-bourbon-edp-100ml-34-unisex-by-lattafa-4009412.jpg?v=1757295136&width=1620'
      }
    ];

    function showSlide(index) {
      currentSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('active', i === currentSlide));
      dots.forEach((dot, i) => dot.classList.toggle('active', i === currentSlide));

      const message = heroMessages[currentSlide];
      const heroActions = document.getElementById('heroActions');

      heroKicker.textContent = message.kicker;
      heroTitle.innerHTML = message.title;
      heroCopy.textContent = message.copy;
      heroActions.innerHTML = message.buttons.map(button => `
        <button class="btn ${button.style}" onclick="${button.action}">${button.text}</button>
      `).join('');
    }

    function changeSlide(direction) {
      showSlide(currentSlide + direction);
    }

    setInterval(() => changeSlide(1), 7000);

    function filterProducts(filter) {
      activeFilter = filter;
      visibleProducts = 6;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === filter);
      });
      document.querySelector('#catalogo').scrollIntoView({ behavior: 'smooth' });
      renderProducts();
    }

    function loadMoreProducts() {
      visibleProducts += 6;
      renderProducts();
    }

    function renderProducts() {
      const grid = document.getElementById('productsGrid');
      const empty = document.getElementById('emptyState');
      const loadMoreBtn = document.getElementById('loadMoreBtn');
      const searchValue = document.getElementById('searchInput').value.trim().toLowerCase();

      const filteredProducts = products.filter(product => {
        const matchesFilter = activeFilter === 'TODOS' || product.category === activeFilter;
        const matchesSearch = [product.name, product.category, product.desc || '', product.tag || '']
          .join(' ')
          .toLowerCase()
          .includes(searchValue);
        return matchesFilter && matchesSearch;
      });

      const visibleList = filteredProducts.slice(0, visibleProducts);

      grid.innerHTML = visibleList.map(product => `
        <article class="product-card">
          <div class="product-image">
            <img src="${product.image}" alt="${product.name}" loading="lazy" />
            ${product.tag ? `<span class="badge">${product.tag}</span>` : ''}
          </div>
          <div class="product-info">
            <p class="product-category">${product.category}</p>
            <h3 class="product-title">${product.name}</h3>
            <div class="product-buy-row">
              <p class="product-price">${product.price}</p>
              <button class="order-btn" onclick="addToCart('${product.name.replace(/'/g, "\'")}')">Pedir</button>
            </div>
          </div>
        </article>
      `).join('');

      if (filteredProducts.length === 0) {
        const waMsg = encodeURIComponent(`Hola tío Wazka, busqué "${searchValue || 'un producto'}" en la web y no aparece. ¿Tienes info sobre ese producto? 🦙🔥`);
        empty.innerHTML = `UPS! Parece que este producto aún no lo cargamos a la web, <a href="https://wa.me/51941641876?text=${waMsg}" target="_blank">presiona aquí</a> para darte mayor información del producto`;
        empty.style.display = 'block';
      } else {
        empty.style.display = 'none';
      }
      loadMoreBtn.classList.toggle('hidden', visibleProducts >= filteredProducts.length || filteredProducts.length === 0);
    }

    function parsePrice(price) {
      return Number(String(price).replace('S/', '').trim()) || 0;
    }

    function addToCart(productName) {
      const product = products.find(item => item.name === productName);
      if (!product) return;

      const existingItem = cart.find(item => item.name === product.name);

      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({ ...product, quantity: 1 });
      }

      renderCart();
    }

    function updateQuantity(productName, change) {
      const item = cart.find(product => product.name === productName);
      if (!item) return;

      item.quantity += change;

      if (item.quantity <= 0) {
        cart = cart.filter(product => product.name !== productName);
      }

      renderCart();
    }

    function removeFromCart(productName) {
      cart = cart.filter(item => item.name !== productName);
      renderCart();
    }

    function renderCart() {
      const cartItems = document.getElementById('cartItems');
      const cartCount = document.getElementById('cartCount');
      const cartTotal = document.getElementById('cartTotal');
      const cartSeparation = document.getElementById('cartSeparation');
      const checkoutBtn = document.getElementById('checkoutBtn');
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      const totalPrice = cart.reduce((sum, item) => sum + parsePrice(item.price) * item.quantity, 0);

      cartCount.textContent = totalItems;
      cartTotal.textContent = `S/ ${totalPrice.toFixed(2)}`;
      cartSeparation.textContent = `S/ ${(totalPrice * 0.3).toFixed(2)}`;
      checkoutBtn.disabled = cart.length === 0;

      if (!cart.length) {
        cartItems.innerHTML = '<div class="cart-empty">Tu carrito está vacío.</div>';
        return;
      }

      cartItems.innerHTML = cart.map(item => `
        <div class="cart-item">
          <img src="${item.image}" alt="${item.name}" />
          <div>
            <h3 class="cart-item-name">${item.name}</h3>
            <p class="cart-item-price">${item.price}</p>
            <div class="cart-item-actions">
              <div class="quantity-control">
                <button onclick="updateQuantity('${item.name.replace(/'/g, "\'")}', -1)">−</button>
                <span>${item.quantity}</span>
                <button onclick="updateQuantity('${item.name.replace(/'/g, "\'")}', 1)">+</button>
              </div>
              <button class="remove-btn" onclick="removeFromCart('${item.name.replace(/'/g, "\'")}')">Quitar</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function toggleCart(open) {
      document.getElementById('cartDrawer').classList.toggle('open', open);
      document.getElementById('cartOverlay').classList.toggle('open', open);
    }

    function checkoutOrder() {
      if (!cart.length) return;

      const lines = cart.map(item => {
        const qty = item.quantity > 1 ? `x${item.quantity} ` : '';
        return `• ${qty}${item.name} – ${item.price}`;
      });

      const totalPrice = cart.reduce((sum, item) => sum + parsePrice(item.price) * item.quantity, 0);
      const separation = (totalPrice * 0.3).toFixed(2);

      const message =
        `Hola tío Wazka, quiero pedir 🦙🔥\n\n` +
        lines.join('\n') +
        `\n\nTotal: S/ ${totalPrice.toFixed(2)}` +
        `\nMonto a separar (30%): S/ ${separation}`;

      const url = `https://wa.me/51941641876?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank');
    }

    function updateCountdown() {
      const countdownTimer = document.getElementById('countdownTimer');
      const targetDate = new Date('2026-05-23T20:00:00-05:00').getTime();
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance <= 0) {
        countdownTimer.textContent = 'Consolidado finalizado';
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      countdownTimer.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s`;
    }

    renderProducts();
    renderCart();
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</body>
</html>
