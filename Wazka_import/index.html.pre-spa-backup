<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wazka Import | Perfumería Urbana</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f5f5;
      color: #111111;
      overflow-x: hidden;
    }

    button,
    input {
      font-family: inherit;
    }

    .countdown-bar {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 60;
      width: 100%;
      min-height: 38px;
      background: #111111;
      color: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 8px 18px;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      text-align: center;
    }

    .countdown-time {
      color: #f5f5f5;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid rgba(245,245,245,0.28);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .navbar {
      position: fixed;
      top: 38px;
      left: 0;
      z-index: 50;
      width: 100%;
      height: 72px;
      background: rgba(245, 245, 245, 0.92);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(17, 17, 17, 0.08);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 38px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 28px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .nav-link {
      color: #111111;
      text-decoration: none;
      transition: opacity 0.25s ease;
    }

    .nav-link:hover {
      opacity: 0.55;
    }

    .brand-logo {
      font-weight: 900;
      font-size: 24px;
      letter-spacing: -0.08em;
      text-transform: uppercase;
      line-height: 1;
    }

    .brand-logo span {
      display: block;
      font-size: 9px;
      letter-spacing: 0.28em;
      text-align: center;
      margin-top: 3px;
      font-weight: 700;
    }

    .mobile-menu {
      display: none;
    }

    .hero {
      margin-top: 110px;
      position: relative;
      min-height: calc(100vh - 110px);
      background: #111111;
      color: #f5f5f5;
      overflow: hidden;
    }

    .hero-slider {
      position: absolute;
      inset: 0;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: scale(1.04);
      transition: opacity 900ms ease, transform 1400ms ease;
    }

    .hero-slide.active {
      opacity: 1;
      transform: scale(1);
    }

    .hero-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(20%) contrast(1.08) brightness(0.72);
    }

    .hero-slide::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 35%, rgba(255,255,255,0.05), transparent 26%),
        linear-gradient(180deg, rgba(17,17,17,0.16), rgba(17,17,17,0.88));
    }

    .hero-content {
      position: relative;
      z-index: 2;
      min-height: calc(100vh - 110px);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      text-align: center;
      padding: 48px 24px 56px;
    }

    .hero-kicker {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .hero-title {
      font-size: clamp(54px, 10vw, 138px);
      line-height: 0.82;
      letter-spacing: -0.09em;
      text-transform: uppercase;
      font-weight: 950;
      max-width: 1000px;
    }

    .hero-title em {
      font-style: normal;
      display: inline-block;
      transform: skew(-9deg);
    }

    .hero-copy {
      margin-top: 18px;
      font-size: clamp(16px, 2vw, 22px);
      max-width: 560px;
      line-height: 1.25;
      color: rgba(245,245,245,0.86);
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 26px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border: 0;
      border-radius: 999px;
      padding: 13px 25px;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.24s ease, opacity 0.24s ease, background 0.24s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: #f5f5f5;
      color: #111111;
    }

    .btn-secondary {
      background: rgba(245,245,245,0.12);
      color: #f5f5f5;
      border: 1px solid rgba(245,245,245,0.38);
    }

    .hero-controls {
      position: absolute;
      z-index: 3;
      right: 34px;
      bottom: 34px;
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .control-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 0;
      background: rgba(245,245,245,0.9);
      color: #111111;
      display: grid;
      place-items: center;
      font-size: 22px;
      font-weight: 900;
      cursor: pointer;
    }

    .dots {
      position: absolute;
      z-index: 3;
      bottom: 25px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(245,245,245,0.45);
      border: 0;
    }

    .dot.active {
      background: #f5f5f5;
    }

    .section {
      padding: 58px 38px;
    }

    .shop-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 36px;
    }

    .filters {
      display: flex;
      gap: 22px;
      flex-wrap: wrap;
    }

    .filter-btn {
      border: 0;
      background: transparent;
      color: #111111;
      font-size: clamp(18px, 2.1vw, 34px);
      font-weight: 900;
      letter-spacing: -0.06em;
      text-transform: uppercase;
      cursor: pointer;
      opacity: 0.32;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .filter-btn:hover,
    .filter-btn.active {
      opacity: 1;
      transform: translateY(-1px);
    }

    .search-box {
      width: min(360px, 100%);
      height: 52px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid rgba(17,17,17,0.08);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 18px;
      box-shadow: 0 10px 28px rgba(17,17,17,0.05);
    }

    .search-box span {
      font-size: 20px;
    }

    .search-box input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 16px;
      color: #111111;
      font-weight: 600;
    }

    .products-wrap {
      padding-bottom: 24px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 34px 22px;
    }

    .load-more-wrap {
      display: flex;
      justify-content: center;
      margin-top: 34px;
    }

    .load-more-btn {
      background: #111111;
      color: #f5f5f5;
      border: 0;
      border-radius: 999px;
      padding: 15px 34px;
      font-size: 16px;
      font-weight: 900;
      cursor: pointer;
      transition: transform 0.24s ease, opacity 0.24s ease;
    }

    .load-more-btn:hover {
      transform: translateY(-2px);
    }

    .load-more-btn.hidden {
      display: none;
    }

    .product-card {
      scroll-snap-align: start;
      cursor: pointer;
    }

    .product-image {
      position: relative;
      aspect-ratio: 1 / 1;
      background: #e9e9e9;
      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .product-card:hover img {
      transform: scale(1.05);
    }

    .badge {
      position: absolute;
      top: 16px;
      left: 16px;
      background: #f5f5f5;
      color: #111111;
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .product-info {
      padding-top: 18px;
    }

    .product-category {
      color: #ff4b00;
      font-size: 15px;
      font-weight: 900;
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .product-title {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: -0.045em;
      line-height: 1.05;
      margin-bottom: 8px;
    }

    .product-desc {
      display: none;
    }

    .product-buy-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 10px;
    }

    .product-price {
      font-size: 18px;
      font-weight: 900;
    }

    .order-btn {
      border: 0;
      border-radius: 999px;
      background: #111111;
      color: #f5f5f5;
      padding: 9px 16px;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
      transition: transform 0.22s ease, opacity 0.22s ease;
      white-space: nowrap;
    }

    .order-btn:hover {
      transform: translateY(-2px);
    }

    .floating-cart {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 80;
      width: 62px;
      height: 62px;
      border-radius: 50%;
      border: 0;
      background: #111111;
      color: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
      cursor: pointer;
      box-shadow: 0 16px 38px rgba(17,17,17,0.22);
      transition: transform 0.24s ease;
    }

    .floating-cart:hover {
      transform: translateY(-3px) scale(1.02);
    }

    .cart-count {
      position: absolute;
      top: -4px;
      right: -4px;
      min-width: 23px;
      height: 23px;
      border-radius: 999px;
      background: #f5f5f5;
      color: #111111;
      border: 2px solid #111111;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 950;
      padding: 0 6px;
    }

    .cart-overlay {
      position: fixed;
      inset: 0;
      z-index: 90;
      background: rgba(17,17,17,0.42);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s ease;
    }

    .cart-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .cart-drawer {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 100;
      width: min(420px, 100%);
      height: 100vh;
      background: #f5f5f5;
      color: #111111;
      transform: translateX(100%);
      transition: transform 0.32s ease;
      display: flex;
      flex-direction: column;
      box-shadow: -20px 0 50px rgba(17,17,17,0.16);
    }

    .cart-drawer.open {
      transform: translateX(0);
    }

    .cart-header {
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 22px;
      background: #111111;
      color: #f5f5f5;
    }

    .cart-title {
      font-size: 22px;
      font-weight: 950;
      letter-spacing: -0.05em;
    }

    .cart-close {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid rgba(245,245,245,0.28);
      background: transparent;
      color: #f5f5f5;
      font-size: 24px;
      cursor: pointer;
    }

    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(17,17,17,0.1);
    }

    .cart-item img {
      width: 72px;
      height: 72px;
      object-fit: cover;
      background: #e9e9e9;
    }

    .cart-item-name {
      font-size: 16px;
      font-weight: 950;
      letter-spacing: -0.035em;
      margin-bottom: 5px;
    }

    .cart-item-price {
      font-size: 14px;
      font-weight: 800;
      color: rgba(17,17,17,0.65);
      margin-bottom: 10px;
    }

    .quantity-control {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(17,17,17,0.14);
      border-radius: 999px;
      overflow: hidden;
    }

    .quantity-control button {
      width: 30px;
      height: 30px;
      border: 0;
      background: #111111;
      color: #f5f5f5;
      font-weight: 900;
      cursor: pointer;
    }

    .quantity-control span {
      min-width: 34px;
      text-align: center;
      font-size: 13px;
      font-weight: 900;
    }

    .cart-item-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 10px;
    }

    .remove-btn {
      border: 0;
      background: transparent;
      color: rgba(17,17,17,0.38);
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
      text-underline-offset: 2px;
      transition: color 0.2s ease;
    }

    .remove-btn:hover {
      color: #ff4b00;
    }

    .cart-empty {
      padding: 48px 0;
      text-align: center;
      font-weight: 900;
      color: rgba(17,17,17,0.5);
    }

    .cart-footer {
      padding: 18px 20px 22px;
      border-top: 1px solid rgba(17,17,17,0.1);
      background: #f5f5f5;
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 18px;
      font-weight: 950;
      margin-bottom: 10px;
    }

    .cart-separation {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 15px;
      font-weight: 900;
      color: rgba(17,17,17,0.68);
      margin-bottom: 16px;
    }

    .checkout-btn {
      width: 100%;
      border: 0;
      border-radius: 999px;
      background: #111111;
      color: #f5f5f5;
      padding: 15px 22px;
      font-size: 16px;
      font-weight: 950;
      cursor: pointer;
    }

    .checkout-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .split-feature {
      background: #111111;
      color: #f5f5f5;
      min-height: 420px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: clamp(56px, 8vw, 100px) 38px;
    }

    .split-feature::before {
      content: "WAZKA IMPORT · WAZKA IMPORT · WAZKA IMPORT · WAZKA IMPORT";
      position: absolute;
      top: 18px;
      left: -20px;
      white-space: nowrap;
      font-size: clamp(38px, 8vw, 110px);
      line-height: 1;
      font-weight: 950;
      letter-spacing: -0.09em;
      color: rgba(245,245,245,0.06);
      text-transform: uppercase;
    }

    .split-feature::after {
      content: "NO HUELAS COMO LOS DEMÁS";
      position: absolute;
      bottom: -8px;
      right: -18px;
      white-space: nowrap;
      font-size: clamp(42px, 9vw, 130px);
      line-height: 1;
      font-weight: 950;
      letter-spacing: -0.1em;
      color: rgba(245,245,245,0.08);
      text-transform: uppercase;
    }

    .feature-image {
      display: none;
    }

    .feature-content {
      position: relative;
      z-index: 2;
      width: min(980px, 100%);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .feature-tag {
      font-size: 14px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: rgba(245,245,245,0.62);
      margin-bottom: 22px;
    }

    .feature-title {
      font-size: clamp(44px, 7vw, 112px);
      line-height: 0.86;
      letter-spacing: -0.09em;
      font-weight: 950;
      text-transform: uppercase;
      margin-bottom: 26px;
    }

    .feature-copy {
      font-size: clamp(17px, 1.6vw, 22px);
      line-height: 1.3;
      color: rgba(245,245,245,0.76);
      max-width: 500px;
      margin-bottom: 28px;
    }

    .how-it-works {
      background: #0d0d0d;
      color: #f5f5f5;
      padding: 72px 38px 56px;
      position: relative;
      overflow: hidden;
    }

    .how-it-works::before {
      content: "WAZKA · IMPORT · CONSOLIDADOS · PERFUMES";
      position: absolute;
      top: 18px;
      left: -18px;
      font-size: clamp(42px, 8vw, 118px);
      line-height: 1;
      font-weight: 950;
      letter-spacing: -0.09em;
      color: rgba(245,245,245,0.045);
      white-space: nowrap;
      text-transform: uppercase;
      pointer-events: none;
    }

    .how-header {
      position: relative;
      z-index: 2;
      text-align: center;
      margin-bottom: 42px;
    }

    .how-title {
      font-size: clamp(38px, 6vw, 72px);
      line-height: 0.92;
      letter-spacing: -0.08em;
      font-weight: 950;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .how-subtitle {
      font-size: 18px;
      color: rgba(245,245,245,0.68);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .how-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .how-card {
      position: relative;
      min-height: 260px;
      border-radius: 18px;
      padding: 22px;
      background: linear-gradient(180deg, rgba(245,245,245,0.055), rgba(245,245,245,0.018));
      border: 1px solid rgba(245,245,245,0.18);
      overflow: hidden;
    }

    .how-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(245,245,245,0.085), transparent 42%);
      pointer-events: none;
    }

    .how-top {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 26px;
    }

    .how-number {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid currentColor;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 950;
      flex-shrink: 0;
    }

    .how-line {
      height: 1px;
      width: 100%;
      background: rgba(245,245,245,0.2);
    }

    .how-card-title {
      position: relative;
      z-index: 2;
      font-size: clamp(26px, 3vw, 38px);
      line-height: 0.96;
      letter-spacing: -0.06em;
      font-weight: 950;
      margin-bottom: 14px;
    }

    .how-card-copy {
      position: relative;
      z-index: 2;
      font-size: 17px;
      line-height: 1.34;
      color: rgba(245,245,245,0.74);
      max-width: 340px;
    }

    .how-accent-1,
    .how-accent-2,
    .how-accent-3 {
      color: #f5f5f5;
      border-color: rgba(245,245,245,0.22);
    }

    .how-card:hover {
      border-color: rgba(245,245,245,0.48);
      background: linear-gradient(180deg, rgba(245,245,245,0.09), rgba(245,245,245,0.025));
    }

    .how-accent-1 .how-card-copy,
    .how-accent-2 .how-card-copy,
    .how-accent-3 .how-card-copy {
      color: rgba(245,245,245,0.74);
    }

    .how-terms {
      position: relative;
      z-index: 2;
      margin-top: 24px;
      text-align: center;
      font-size: 13px;
      color: rgba(245,245,245,0.52);
      line-height: 1.4;
    }

    .how-terms a {
      color: rgba(245,245,245,0.84);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .footer {
      padding: 38px;
      background: #f5f5f5;
      color: #111111;
      display: flex;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      border-top: 1px solid rgba(17,17,17,0.08);
      font-weight: 800;
    }

    .empty-state {
      display: none;
      padding: 60px 0;
      font-size: 28px;
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 1.2;
    }

    .empty-state a {
      color: #ff4b00;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }

    @media (max-width: 920px) {
      .navbar {
        padding: 0 18px;
        grid-template-columns: 1fr auto 1fr;
      }

      .countdown-bar {
        font-size: 12px;
      }

      .nav-right {
        gap: 16px;
        font-size: 14px;
      }

      .shop-head {
        align-items: flex-start;
        flex-direction: column;
      }

      .split-feature {
        padding-inline: 18px;
      }

      .how-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .hero-content {
